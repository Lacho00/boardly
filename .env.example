DATABASE_URL="file:./dev.db"
# Optional: raises the PageSpeed Insights quota (https://developers.google.com/speed/docs/insights/v5/get-started)
GOOGLE_PSI_API_KEY=
# Optional: when set, /api/cron/* requires "Authorization: Bearer <value>" (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional: read-only public demo (blocks writes, cron and scans). Needed at build and runtime.
# DEMO_MODE=1
