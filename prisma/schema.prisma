generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Site {
  id           String   @id @default(cuid())
  name         String
  url          String   @unique
  type         String   @default("wordpress")
  active       Boolean  @default(true)
  wpAppPassword     String?
  useLocalLighthouse Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  healthChecks         HealthCheck[]
  performanceSnapshots PerformanceSnapshot[]
  seoAudits            SeoAudit[]
  accessibilityScores  AccessibilityScore[]
  sslChecks            SslCheck[]
  monthlyReports       MonthlyReport[]
  alerts               Alert[]
}

model Alert {
  id        String   @id @default(cuid())
  siteId    String
  type      String
  message   String
  severity  String   @default("warning")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id])
}

model Config {
  id    String @id @default("global")
  slackWebhook String?
  emailTo     String?
  emailFrom   String?
}

model HealthCheck {
  id           String   @id @default(cuid())
  siteId       String
  status       String
  wpVersion    String?
  plugins      Int?
  responseTime Int?
  checkedAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id])
}

model PerformanceSnapshot {
  id             String   @id @default(cuid())
  siteId         String
  lcp            Float?
  fid            Float?
  cls            Float?
  ttfb           Float?
  score          Int?
  bestPractices  Int?
  checkedAt      DateTime @default(now())
  site           Site     @relation(fields: [siteId], references: [id])
}

model SeoAudit {
  id          String   @id @default(cuid())
  siteId      String
  title       String?
  description String?
  h1Count     Int?
  imgNoAlt    Int?
  score       Int?
  checkedAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id])
}

model AccessibilityScore {
  id        String   @id @default(cuid())
  siteId    String
  score     Int?
  issues    Int?
  checkedAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id])
}

model SslCheck {
  id            String   @id @default(cuid())
  siteId        String
  valid         Boolean
  expiresAt     String?
  daysRemaining Int?
  issuer        String?
  checkedAt     DateTime @default(now())
  site          Site     @relation(fields: [siteId], references: [id])
}

model MonthlyReport {
  id               String   @id @default(cuid())
  siteId           String
  month            Int
  year             Int
  avgPerformance   Float?
  avgSeo           Float?
  avgAccessibility Float?
  uptime           Float?
  pdfUrl           String?
  createdAt        DateTime @default(now())
  site             Site     @relation(fields: [siteId], references: [id])

  @@unique([siteId, month, year])
}
